{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "env": {}
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/takeshi/Documents/GitHub/rental-system"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "${DEV_DATABASE_URL}"
      ]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    },
    "serena": {
      "command": "/Users/takeshi/.anyenv/envs/pyenv/versions/3.12.13/bin/serena",
      "args": [
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "desktop-app",
        "--open-web-dashboard",
        "false"
      ]
    }
  }
}
